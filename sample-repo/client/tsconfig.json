{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@vibecode/shared": ["../shared/dist/index.d.ts"],
      "@game/*": ["./src/game/*"],
      "@scenes/*": ["./src/scenes/*"],
      "@constants/*": ["./src/constants/*"]
    }
  },
  "include": ["src"]
}
